---
eleventyComputed:
  title: "{{ config.title }}"
  description: "{{ config.description }}"
layout: index_layout.njk
eleventyExcludeFromCollections: true
---

<section class="section is-flex-grow-1">
  <style>
    .langs {
      display: flex;
      justify-content: center;
      list-style: none;
      padding: 0;
      flex-wrap: wrap;
    }
    .langs li {
      margin: 0.5rem;
    }
    h1 {
      text-align: center;
    }
  </style>
  <div class="container">
    <h1 class="title is-1 is-size-3-mobile has-text-weight-bold is-centered">Select your language</h1>
    <br/>
    <ul class="langs">
      {% for lang in config.languages %}
        <li>
          <a href="/{{ lang }}/" data-lang="{{ lang }}">{{ lang | langNativeName }}</a>
        </li>
      {% endfor %}
    </ul>
  </div>
  <script>
    (function () {
      var STORAGE_KEY = "preferredLang";

      function storageGet() {
        try { return localStorage.getItem(STORAGE_KEY); } catch (e) { return null; }
      }

      function storageSet(value) {
        try { localStorage.setItem(STORAGE_KEY, value); } catch (e) {}
      }

      /* Remember the language the user picks manually */
      var links = document.querySelectorAll(".langs a[data-lang]");
      for (var i = 0; i < links.length; i++) {
        links[i].addEventListener("click", function () {
          storageSet(this.getAttribute("data-lang"));
        });
      }

      /* Don't redirect crawlers: they should see and index the language list */
      if (/bot|crawl|spider|slurp|lighthouse|facebookexternalhit|preview/i.test(navigator.userAgent || "")) return;

      /* Don't redirect if the user explicitly asked for this page */
      if (/[?&]nolang\b/.test(location.search)) return;
      if (document.referrer) {
        try {
          if (new URL(document.referrer).host === location.host) return;
        } catch (e) {}
      }

      function supported(tag) {
        if (!tag) return null;
        var code = String(tag).toLowerCase().split(/[-_]/)[0];
        return ALL_LOCALES.indexOf(code) !== -1 ? code : null;
      }

      var target = supported(storageGet());
      if (!target) {
        var prefs = navigator.languages && navigator.languages.length
          ? navigator.languages
          : [navigator.language || navigator.userLanguage];
        for (var j = 0; j < prefs.length && !target; j++) {
          target = supported(prefs[j]);
        }
      }

      if (target) location.replace("/" + target + "/");
    })();
  </script>
</section>