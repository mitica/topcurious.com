<!doctype html>
<html lang="{{ locale or 'en' }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    {%- set isPost = layout === 'post.njk' %}
    {%- set pageTitle = (title or config.name) | trim %}
    {%- if layout === 'index_layout.njk' and pagination and pagination.pageNumber > 0 %}
      {%- set pageTitle = pageTitle + ' – ' + (pagination.pageNumber + 1) %}
    {%- endif %}
    {%- set pageDescription = (description or config.description) | trim %}
    {%- set pageUrl = config.url + page.url %}
    {%- set pageImage = config.url + (featuredImageLarge if featuredImageLarge else '/_images/default.jpg') %}
    {%- set translations = page.url | translations(collections.all) %}

    <title>{{ pageTitle }}</title>
    <meta name="description" content="{{ pageDescription }}">
    {% if layout === '404.njk' %}
      <meta name="robots" content="noindex">
    {% else %}
      <meta name="robots" content="max-image-preview:large">
      <link rel="canonical" href="{{ pageUrl }}">
    {% endif %}

    {% if translations.length > 1 %}
      {% for item in translations %}
        <link rel="alternate" hreflang="{{ item.lang }}" href="{{ config.url }}{{ item.url }}">
      {% endfor %}
      {% if page.url === '/' + locale + '/' %}
        <link rel="alternate" hreflang="x-default" href="{{ config.url }}/">
      {% elif translations[0].lang === 'en' %}
        <link rel="alternate" hreflang="x-default" href="{{ config.url }}{{ translations[0].url }}">
      {% endif %}
    {% elif page.url === '/' %}
      {% for lang in config.languages %}
        <link rel="alternate" hreflang="{{ lang }}" href="{{ config.url }}/{{ lang }}/">
      {% endfor %}
      <link rel="alternate" hreflang="x-default" href="{{ config.url }}/">
    {% endif %}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,ital@9..144,400..700,0;9..144,400..700,1&family=Inter:wght@400;500;600;700&display=swap">
    <link rel="stylesheet" href="{{ '/theme.css' | url }}">
    <link rel="icon" type="image/png" href="/_images/icon-180.png" sizes="180x180">
    <link rel="icon" type="image/png" href="/_images/icon-64.png" sizes="64x64">
    <link rel="icon" type="image/png" href="/_images/icon-32.png" sizes="32x32">
    <link rel="icon" href="/_images/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/_images/icon-180.png">

    <meta property="og:site_name" content="{{ config.name }}">
    <meta property="og:type" content="{{ 'article' if isPost else 'website' }}">
    <meta property="og:title" content="{{ pageTitle }}">
    <meta property="og:description" content="{{ pageDescription }}">
    <meta property="og:url" content="{{ pageUrl }}">
    <meta property="og:locale" content="{{ (locale or 'en') | ogLocale }}">
    <meta property="og:image" content="{{ pageImage }}">
    {% if featuredImageLarge %}
      <meta property="og:image:width" content="1200">
      <meta property="og:image:height" content="675">
    {% else %}
      <meta property="og:image:width" content="1200">
      <meta property="og:image:height" content="630">
    {% endif %}
    <meta property="og:image:alt" content="{{ pageTitle }}">
    <meta name="twitter:card" content="summary_large_image">

    {% if isPost %}
      <meta property="article:published_time" content="{{ page.date.toISOString() }}">
      {% for tag in tags %}
        <meta property="article:tag" content="{{ tag }}">
      {% endfor %}
      {% if youtubeVideoId %}
        <meta property="og:video" content="https://www.youtube.com/embed/{{ youtubeVideoId }}">
        <meta property="og:video:type" content="text/html">
      {% endif %}
      <script type="application/ld+json">{{ {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        "headline": title | trim,
        "description": pageDescription,
        "image": [pageImage, config.url + featuredImageMedium],
        "datePublished": page.date.toISOString(),
        "dateModified": page.date.toISOString(),
        "inLanguage": locale,
        "keywords": tags | join(", "),
        "mainEntityOfPage": pageUrl,
        "url": pageUrl,
        "author": { "@type": "Organization", "name": config.name, "url": config.url },
        "publisher": {
          "@type": "Organization",
          "name": config.name,
          "url": config.url,
          "logo": { "@type": "ImageObject", "url": config.url + "/_images/icon-512.png" }
        }
      } | jsonLd | safe }}</script>
    {% elif layout === 'index_layout.njk' and not (pagination and pagination.pageNumber > 0) %}
      <script type="application/ld+json">{{ {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": config.name,
        "url": pageUrl,
        "description": pageDescription,
        "inLanguage": locale or config.languages,
        "publisher": {
          "@type": "Organization",
          "name": config.name,
          "url": config.url,
          "logo": { "@type": "ImageObject", "url": config.url + "/_images/icon-512.png" },
          "sameAs": [config.social.youtube, config.social.github]
        }
      } | jsonLd | safe }}</script>
    {% endif %}

    {# {% set css %}
      {% include "custom.css" %}
    {% endset %}
    <style>
      {{ css | cssmin | safe }}
    </style> #}
    {# <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3959589883092051"
     crossorigin="anonymous"></script> #}
     <script>var CURRENT_LOCALE = '{{ locale }}';var ALL_LOCALES={{ config.languages | stringify | safe }};</script>
  </head>
